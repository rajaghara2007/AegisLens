# Server Port (Render injects PORT automatically)
PORT=4000

# Application Environment
NODE_ENV=production

# Frontend Origin URL (Allowed CORS origins)
CORS_ORIGIN=*

# Service Identification
SERVICE_NAME=SecureMon-AegisLens-API
API_VERSION=1.0.0

# Optional: External AI Model / LLM API Key
# GEMINI_API_KEY=
# OPENAI_API_KEY=
